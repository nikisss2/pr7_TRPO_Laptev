<Window x:Class="pr7_convert_Laptev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:pr7_convert_Laptev.Converters"
        Title="Прокат автомобиля" Height="500" Width="800" MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:DiscountConverter x:Key="discountConverter"/>
        <converters:StrikethroughConverter x:Key="strikethroughConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0 0 15 0">

            <TextBlock Text="Модель автомобиля:" Margin="0 5 0 2"/>
            <TextBox Text="{Binding CarModel, UpdateSourceTrigger=PropertyChanged}" Height="28"/>

            <TextBlock Text="Стоимость за сутки:" Margin="0 10 0 2"/>
            <TextBox Text="{Binding DailyPrice, UpdateSourceTrigger=PropertyChanged}" Height="28"/>

            <TextBlock Text="Количество дней:" Margin="0 10 0 2"/>
            <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Height="28"/>

            <TextBlock Text="Скидка %:" Margin="0 10 0 2"/>
            <TextBox Text="{Binding Discount, Converter={StaticResource discountConverter}, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="15 0 0 0">

            <TextBlock Text="Автомобиль:" Margin="0 5 0 2"/>
            <TextBlock Text="{Binding CarModel}" FontSize="15"/>

            <TextBlock Text="Тариф за сутки:" Margin="0 10 0 2"/>
            <TextBlock Text="{Binding DailyPrice, StringFormat={}{0:C}, ConverterCulture=ru-RU}" FontSize="15"/>

            <TextBlock Text="Срок аренды:" Margin="0 10 0 2"/>
            <TextBlock Text="{Binding Days, StringFormat={}{0} дн.}" FontSize="15"/>

            <TextBlock Text="Скидка клиента:" Margin="0 10 0 2"/>
            <TextBlock Text="{Binding Discount, StringFormat={}{0:P0}}" FontSize="15"/>

            <TextBlock Text="Начальная стоимость:" Margin="0 10 0 2"/>
            <TextBlock Text="{Binding InitialCost, StringFormat={}{0:C}, ConverterCulture=ru-RU}"
                       TextDecorations="{Binding Discount, Converter={StaticResource strikethroughConverter}}"
                       FontSize="15"/>

            <TextBlock Text="Итого к оплате:" Margin="0 15 0 2" FontWeight="Bold"/>
            <TextBlock Text="{Binding RentalCost, StringFormat={}{0:C}, ConverterCulture=ru-RU}"
                       FontSize="15" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
